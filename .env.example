# Server Configuration
HOST=0.0.0.0
PORT=5000

# OCR Configuration
OCR_ENGINE=paddle
OCR_DEBUG=true

# PaddleOCR Configuration
PADDLE_DEVICE=cpu
PADDLE_USE_DOC_ORIENTATION=false
PADDLE_USE_DOC_UNWARPING=false
PADDLE_USE_TEXTLINE_ORIENTATION=false

# Ollama / GLM-OCR Configuration (Keep intact for fallback/comparison)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GLM_OCR_MODEL=glm-ocr:latest
GLM_OCR_TIMEOUT=180
GLM_OCR_NUM_PREDICT=512
GLM_OCR_TEMPERATURE=0
